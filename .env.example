# ---------------------------------------------------------------------------
# Sitecore Content Export Tool — copy to .env.local and fill in.
#
# Minimum local setup: SITECORE_ENVIRONMENTS + DISABLE_AUTH/NEXT_PUBLIC_DISABLE_AUTH.
# ---------------------------------------------------------------------------

# ---------- Auth toggles ----------

# true  → API routes skip all JWT verification   (LOCAL / INTERNAL USE ONLY)
# false → every API route requires an Organization Admin/Owner user token
DISABLE_AUTH=true
# Same switch for the browser: true hides the Auth0 login screen.
NEXT_PUBLIC_DISABLE_AUTH=true

# ---------- Environments (server-only — never exposed to the browser) ----------

# JSON array. Must be a SINGLE LINE (dotenv only keeps multi-line values when
# the whole value is wrapped in double quotes).
#
#   name         display name in the environment dropdown
#   host         XM Cloud Deploy → Environment → Details → CM URL
#   apiKey       CM host → /sitecore/api/graph/edge Playground → Settings → API Key
#                REQUIRED — this is what runs the export
#   clientId     Deploy → Environment → Credentials → Create (Automation scope)
#   clientSecret  "
#                OPTIONAL — only powers the content tree browser. Without them
#                you can still export by typing page paths in manually.
#
# ---------------------------------------------------------------------------
# IMPORTANT — use the CM (preview) host, NOT Experience Edge delivery.
#
# The app calls {host}/sitecore/api/graph/edge. Point `host` at the CM URL
# (https://xmc-<org>-<project>-<env>.sitecorecloud.io).
#
# Do NOT point it at an Experience Edge delivery host (edge.sitecorecloud.io).
# Delivery is capped at 80 requests/second for the WHOLE organisation, and an
# export issues one request per page back to back — it will compete with your
# live sites and can get you rate limited. Run large exports off-peak.
# ---------------------------------------------------------------------------
SITECORE_ENVIRONMENTS=[{"name":"Dev","host":"https://xmc-yourorg-yourproject-dev.sitecorecloud.io","apiKey":"","clientId":"","clientSecret":""}]

# ---------- Auth0 SSO (only needed when DISABLE_AUTH=false) ----------

# Server side
SITECORE_AUTH_DOMAIN=https://auth.sitecorecloud.io
SITECORE_USER_TOKEN_AUDIENCE=https://api-webapp.sitecorecloud.io
SITECORE_MACHINE_TOKEN_AUDIENCE=https://api.sitecorecloud.io
# Must match the org_id claim in user tokens.
SITECORE_ORG_ID=
# Role values (comma-separated, substring match) accepted as admin.
SITECORE_ADMIN_ROLE_PATTERNS=Organization Admin,Organization Owner

# Client side
NEXT_PUBLIC_AUTH0_DOMAIN=auth.sitecorecloud.io
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api-webapp.sitecorecloud.io
NEXT_PUBLIC_AUTH0_SCOPE=openid profile email offline_access
NEXT_PUBLIC_SITECORE_ORG_ID=

# ---------- Runtime credentials modal ----------

# true → the in-app "Credentials" modal can add environments for the lifetime of
# the server process (never written to disk). Set false to lock the app to
# SITECORE_ENVIRONMENTS only.
ALLOW_RUNTIME_CREDENTIALS=true
NEXT_PUBLIC_ALLOW_RUNTIME_CREDENTIALS=true
